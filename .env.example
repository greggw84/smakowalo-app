# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/smakowalo
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenCart Integration
OPENCART_URL=https://shop.smakowalo.pl
OPENCART_API_TOKEN=your-opencart-api-token
OPENCART_API_USERNAME=your-opencart-username

# Analytics & Tracking
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=123456789012345
NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-verification-code

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://smakowalo.pl
NEXT_PUBLIC_SITE_NAME=Smakowało

# Email Services (Choose one)
# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@smakowalo.pl

# Resend
RESEND_API_KEY=your-resend-api-key

# AWS SES
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-west-1

# Caching
CACHE_TTL=3600

# Security
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=https://smakowalo.pl

# Payment Processing - Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRODUCT_ID=prod_...

# Application URL (required for Stripe redirects)
NEXT_PUBLIC_APP_URL=https://smakowalo.pl

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_CHAT=false
NEXT_PUBLIC_ENABLE_BLOG=false

# Development
NODE_ENV=development
